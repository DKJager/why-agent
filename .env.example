# Model provider (Meterless Runtime, OpenAI-compatible)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_API_KEY=your-key-here
MODEL_ID=meterless/auto
# Sponsor services
ZETARIS_REST_URL=https://your-zetaris-host.example/api/v1.0
ZETARIS_ORG_ID=your-org-id
ZETARIS_API_KEY=your-key-here
NVIDIA_API_KEY=your-key-here
# Runtime behaviour (set SAMPLE_MODE=false for live mode)
SAMPLE_MODE=true
LOG_LEVEL=INFO
PORT=8000
# Optional: LIVE_PROVIDER=sample runs live Zetaris data with the local sample provider
LIVE_PROVIDER=meterless
